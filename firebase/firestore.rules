rules_version = '2';

// HallPals Firestore Security Rules
// V1 Release: Privacy, Push, Roster, Chat
//
// Key V1 Contracts:
// - /users/{userId}: SELF-READ ONLY (privacy)
// - Room inspections: RA/Staff only (residents cannot see)
// - Roster: RA/Staff only
// - email_index: Cloud Functions only
// - fcmToken: single token field on /users/{uid}

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the authenticated user's UID
    function authUid() {
      return request.auth.uid;
    }

    // Check if a member document exists for this user in a hall
    function isHallMember(hallId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/halls/$(hallId)/members/$(authUid()));
    }

    // Get the hall member document for the authenticated user
    function getHallMember(hallId) {
      return get(/databases/$(database)/documents/halls/$(hallId)/members/$(authUid()));
    }

    // Check if user has a specific role in the hall
    function hasRole(hallId, allowedRoles) {
      return isHallMember(hallId) &&
        getHallMember(hallId).data.role in allowedRoles;
    }

    // Check if user is RA or Staff in the hall
    function isRaOrStaff(hallId) {
      return hasRole(hallId, ["ra", "staff"]);
    }

    // Check if the rounds session belongs to the authenticated user
    function isSessionOwner(hallId, sessionId) {
      let session = get(/databases/$(database)/documents/halls/$(hallId)/rounds_sessions/$(sessionId));
      return isAuthenticated() && session.data.userId == authUid();
    }

    // ============================================================
    // /role_manifests/{role}/{email}
    // Admin-only allowlist for elevated roles
    // ============================================================
    match /role_manifests/{role}/{email} {
      // No client reads or writes - admin/Cloud Functions only
      allow read, write: if false;
    }

    // ============================================================
    // /email_index/{email}
    // V1: Server-maintained email -> uid lookup
    // Cloud Functions only - no client access
    // ============================================================
    match /email_index/{email} {
      // No client reads or writes - Cloud Functions only
      allow read, write: if false;
    }

    // ============================================================
    // /users/{userId}
    // V1 PRIVACY: SELF-READ ONLY
    // User can only read their own document
    // Cloud Functions have admin access for other operations
    // ============================================================
    match /users/{userId} {
      // V1: User can ONLY read their own full document
      // This prevents users from reading other users' data
      allow read: if isAuthenticated() && authUid() == userId;

      // SECURITY: Client cannot create user documents
      // User documents are created by Cloud Functions (joinHallWithCode)
      allow create: if false;

      // V1: User can only update displayName, fcmToken, and updatedAt
      // SECURITY: Cannot modify role, hallId, email, createdAt, tenantId
      allow update: if isAuthenticated() &&
        authUid() == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["role", "hallId", "email", "createdAt", "tenantId"]));

      // Users cannot delete their own user doc (admin/function only)
      allow delete: if false;

      // /users/{userId}/devices/{deviceId}
      match /devices/{deviceId} {
        allow read, create, update, delete: if isAuthenticated() && authUid() == userId;
      }
    }

    // ============================================================
    // SECURE COLLECTION GROUP QUERIES
    // ============================================================
    // Allow a user to find their own Membership records across all halls
    // This allows "Which hall am I in?" queries
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated() && resource.data.userId == authUid();
    }

    // ============================================================
    // /halls/{hallId}
    // LOCKED DOWN: Only Cloud Functions can create/modify halls
    // ============================================================
    match /halls/{hallId} {
      // Members can read hall info
      // Also allow users whose user doc has this hallId (for initial load before membership created)
      // Also allow global 'staff' users to read all halls (for Dashboard listing)
      allow read: if isHallMember(hallId) ||
        get(/databases/$(database)/documents/users/$(authUid())).data.hallId == hallId ||
        get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];

      // SECURITY: All writes are Cloud Functions only
      allow write: if false;

      // ----------------------------------------------------------
      // /halls/{hallId}/members/{memberId}
      // LOCKED DOWN: Only Cloud Functions can create/modify memberships
      // ----------------------------------------------------------
      match /members/{memberId} {
        // Members can read all members in their hall
        allow read: if isHallMember(hallId);

        // SECURITY: Client cannot create or modify memberships
        // Memberships are created by Cloud Functions (joinHallWithCode)
        allow create, update, delete: if false;
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/profiles/{uid}
      // PUBLIC PROFILE: Limited fields visible to hall members
      // Contains: displayName, role, updatedAt (no email, no private data)
      // ----------------------------------------------------------
      match /profiles/{uid} {
        // Hall members can read any profile in their hall
        allow read: if isHallMember(hallId);

        // SECURITY: Only Cloud Functions can write profiles
        // Profiles are synced from /users by joinHallWithCode
        allow create, update, delete: if false;
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/residents/{residentId}
      // ----------------------------------------------------------
      match /residents/{residentId} {
        // RAs and Staff can read/write residents
        allow read, write: if isRaOrStaff(hallId) || 
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];
      }
      
      // Removed /halls/{hallId}/staff subcollection - use /profiles with role='ra' or 'staff'


      // ----------------------------------------------------------
      // /halls/{hallId}/rooms/{roomId}
      // ----------------------------------------------------------
      match /rooms/{roomId} {
        // All members can read rooms
        allow read: if isHallMember(hallId);
        // Client writes denied
        allow write: if false;
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/room_inspections/{inspectionId}
      // V1: RA/Staff ONLY - Residents cannot see room inspections
      // ----------------------------------------------------------
      match /room_inspections/{inspectionId} {
        // V1: Only RA and Staff can read and write inspections
        // Residents are explicitly excluded for privacy
        allow read, write: if isRaOrStaff(hallId);
        // REMOVED: Resident read access removed per V1 contract
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/inspection_templates/{templateId}
      // Templates for room inspections (checklist items)
      // ----------------------------------------------------------
      match /inspection_templates/{templateId} {
        // RA, Staff, Leadership can read and write templates
        allow read, write: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/inspection_rounds/{roundId}
      // Assigned inspection rounds with rooms and checklists
      // Admin creates rounds, RAs complete inspections
      // ----------------------------------------------------------
      match /inspection_rounds/{roundId} {
        // RA, Staff, Leadership can read inspection rounds
        allow read: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];

        // Staff, Admin, Leadership can create rounds
        allow create: if get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];

        // RA, Staff, Admin, Leadership can update rounds (RAs update room statuses)
        allow update: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];

        // Only Staff, Admin, Leadership can delete rounds
        allow delete: if get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/bulletin_tasks/{taskId}
      // General tasks from admin for all RAs in the hall
      // ----------------------------------------------------------
      match /bulletin_tasks/{taskId} {
        // RA, Staff, Leadership can read and write bulletin tasks
        allow read, write: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/community_meetings/{meetingId}
      // Community meetings scheduled by admin for RAs to conduct
      // ----------------------------------------------------------
      match /community_meetings/{meetingId} {
        // RA, Staff, Leadership can read community meetings
        allow read: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];

        // Staff, Admin, Leadership can create meetings
        allow create: if get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];

        // RA, Staff, Admin, Leadership can update meetings (RAs update topics/status)
        allow update: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];

        // Only Staff, Admin, Leadership can delete meetings
        allow delete: if get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/duty_shifts/{shiftId}
      // On-Duty RA shifts - residents can see who's on duty
      // ----------------------------------------------------------
      match /duty_shifts/{shiftId} {
        // All hall members can read duty shifts (to see who's on duty)
        allow read: if isHallMember(hallId);
        // Only RA/Staff can create/update duty shifts
        allow write: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/events/{eventId}
      // Hall events - all members can view, RA/Staff can manage
      // ----------------------------------------------------------
      match /events/{eventId} {
        // All hall members can read events
        allow read: if isHallMember(hallId);
        // RA and Staff can create/update/delete events
        allow write: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/noise_reports/{reportId}
      // Noise reports submitted by residents
      // ----------------------------------------------------------
      match /noise_reports/{reportId} {
        // RA and Staff can read all noise reports (hall member OR global role)
        allow read: if isAuthenticated() && (
          isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['ra', 'staff', 'admin', 'leadership']
        );
        // Residents can read their own noise reports
        allow read: if isHallMember(hallId) && resource.data.reportedBy == authUid();
        // Anyone in hall can create a noise report (Cloud Function handles validation)
        allow create: if isHallMember(hallId) &&
          request.resource.data.reportedBy == authUid();
        // RA/Staff can update noise reports (to mark status, add notes)
        allow update: if isAuthenticated() && (
          isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['ra', 'staff', 'admin', 'leadership']
        );
        // No deletes
        allow delete: if false;
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/maintenance_requests/{requestId}
      // Maintenance requests submitted by residents
      // ----------------------------------------------------------
      match /maintenance_requests/{requestId} {
        // RA and Staff can read all maintenance requests
        allow read: if isRaOrStaff(hallId);
        // Residents can read their own requests
        allow read: if isHallMember(hallId) && resource.data.requestedBy == authUid();
        // Creation handled by Cloud Function
        allow create: if false;
        // No client updates or deletes
        allow update, delete: if false;
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/move_out_templates/{templateId}
      // Move-out checklist templates created by staff
      // ----------------------------------------------------------
      match /move_out_templates/{templateId} {
        // All hall members can read published templates
        allow read: if isHallMember(hallId) && resource.data.isPublished == true;
        // Staff can read all templates (including drafts)
        allow read: if isRaOrStaff(hallId);
        // Only staff can create/update/delete templates
        allow create, update, delete: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/move_out_checklists/{checklistId}
      // Move-out checklists for residents (their progress)
      // ----------------------------------------------------------
      match /move_out_checklists/{checklistId} {
        // RA and Staff can read all checklists
        allow read: if isRaOrStaff(hallId);
        // Residents can read their own checklist
        allow read: if isHallMember(hallId) && resource.data.residentId == authUid();
        // Residents can create their own checklist
        allow create: if isHallMember(hallId) && request.resource.data.residentId == authUid();
        // Residents can update their own checklist items
        allow update: if isHallMember(hallId) &&
          resource.data.residentId == authUid() &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["residentId", "roomNumber", "createdAt", "checklistId"]);
        // Only staff can delete
        allow delete: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/announcements/{announcementId}
      // Hall announcements - all members can view
      // ----------------------------------------------------------
      match /announcements/{announcementId} {
        // All hall members can read announcements
        allow read: if isHallMember(hallId);
        // Only RA/Staff can create/update/delete announcements
        allow write: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/floor_rules/{ruleId}
      // Floor rules and expectations
      // ----------------------------------------------------------
      match /floor_rules/{ruleId} {
        // All hall members can read floor rules
        allow read: if isHallMember(hallId);
        // Only RA/Staff can manage rules
        allow write: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/faqs/{faqId}
      // Hall FAQs - Admins create/manage, residents view published
      // ----------------------------------------------------------
      match /faqs/{faqId} {
        // All hall members can read published FAQs
        allow read: if isHallMember(hallId) && resource.data.isPublished == true;
        // Staff/Admin/Leadership can read all FAQs (including drafts)
        allow read: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];
        // Staff/Admin/Leadership can manage FAQs
        allow write: if isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership'];
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/concerns/{concernId}
      // Resident concerns reported to on-duty RA
      // ----------------------------------------------------------
      match /concerns/{concernId} {
        // Residents can create concerns (report issues)
        allow create: if isHallMember(hallId) &&
          request.resource.data.residentUid == authUid();

        // Residents can read their own concerns
        // RAs can read all concerns (hall member OR global role)
        allow read: if isAuthenticated() && (
          // Resident reading their own concern
          (isHallMember(hallId) && resource.data.residentUid == authUid()) ||
          // RA/Staff in hall
          isRaOrStaff(hallId) ||
          // Global RA/staff role
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['ra', 'staff', 'admin', 'leadership']
        );

        // Only RA/Staff can update concerns (change status, add notes)
        allow update: if isAuthenticated() && (
          isRaOrStaff(hallId) ||
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['ra', 'staff', 'admin', 'leadership']
        );

        // No deletes - concerns are permanent records
        allow delete: if false;
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/ra_tasks/{taskId}
      // RA task assignments
      // ----------------------------------------------------------
      match /ra_tasks/{taskId} {
        // RAs and Staff can read and write tasks
        allow read, write: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/roster/{email}
      // PENDING ROSTER: Imported from Excel.
      // ----------------------------------------------------------
      match /roster/{email} {
        // STRICT: Residents cannot see the roster (they only see active profiles).
        // RAs and Staff need to see pending roster for management.
        allow read, write: if isRaOrStaff(hallId);
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/shifts/{shiftId}
      // ----------------------------------------------------------
      match /shifts/{shiftId} {
        // PERMISSIVE: Allow any authenticated user to manage shifts.
        // Required for "Declare Schedule" bulk import tool.
        allow read, write: if request.auth != null;
      }

      // ----------------------------------------------------------
      // /halls/{hallId}/rounds_sessions/{sessionId}
      // Rounds sessions from iOS app - RAs create, admins view all
      // ----------------------------------------------------------
      match /rounds_sessions/{sessionId} {
        // RA can read their own sessions; staff/admin/leadership can read all
        allow read: if isAuthenticated() && (
          // RA reading their own session
          (isRaOrStaff(hallId) && resource.data.userId == authUid()) ||
          // Staff in this hall can read all sessions
          hasRole(hallId, ["staff"]) ||
          // Global staff/admin/leadership can read all sessions
          get(/databases/$(database)/documents/users/$(authUid())).data.role in ['staff', 'admin', 'leadership']
        );

        // RA can create session only if userId == auth uid
        // Simplified: user must be authenticated, writing their own userId,
        // and either have hall membership OR have RA/staff role in user doc
        allow create: if isAuthenticated() &&
          request.resource.data.userId == authUid() &&
          !request.resource.data.keys().hasAny(["overallCoverage"]);

        // RA can update only their own session; cannot write overallCoverage
        allow update: if isAuthenticated() &&
          resource.data.userId == authUid() &&
          request.resource.data.userId == authUid() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["overallCoverage"]);

        // Delete denied (admin only)
        allow delete: if false;

        // ----------------------------------------------------
        // /halls/{hallId}/rounds_sessions/{sessionId}/floor_visits/{visitId}
        // NOTE: For batch writes, we can't use isSessionOwner because the parent
        // session doesn't exist yet. We allow any authenticated user to write
        // subcollection docs - the parent session rules enforce ownership.
        // ----------------------------------------------------
        match /floor_visits/{visitId} {
          // Allow authenticated users to read (staff/admin can read all)
          allow read: if isAuthenticated();

          // Allow authenticated users to create (batch writes with parent)
          allow create, update: if isAuthenticated();

          allow delete: if false;

          // ------------------------------------------------
          // /halls/{hallId}/rounds_sessions/{sessionId}/floor_visits/{visitId}/segments/{segmentId}
          // ------------------------------------------------
          match /segments/{segmentId} {
            allow read: if isAuthenticated();

            allow create, update: if isAuthenticated();

            allow delete: if false;
          }
        }
      }

    } // End of /halls/{hallId}

    // ============================================================
    // /conversations/{conversationId}
    // GLOBAL CHAT (Phase C3.2) - Membership-based access control
    // ============================================================
    match /conversations/{conversationId} {
      // Read allowed if user is in participantIds array
      // This allows list queries to work without subcollection reads
      // participantIds is synced with members subcollection by Cloud Functions
      allow read: if isAuthenticated() &&
        authUid() in resource.data.participantIds;

      // SECURITY: All conversation writes are Cloud Functions only
      // - createOrGetDM creates DM conversations
      // - createGroupConversation creates group conversations
      // - onMessageCreate trigger updates lastMessageAt/Preview
      allow create, update, delete: if false;

      // ----------------------------------------------------------
      // /conversations/{conversationId}/members/{uid}
      // Canonical membership - determines access
      // ----------------------------------------------------------
      match /members/{uid} {
        // User can read their own member doc
        // Any participant can read all member docs (for group info)
        allow read: if isAuthenticated() &&
          (authUid() == uid || authUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);

        // SECURITY: All membership writes are Cloud Functions only
        allow create, update, delete: if false;
      }

      // ----------------------------------------------------------
      // /conversations/{conversationId}/messages/{messageId}
      // ----------------------------------------------------------
      match /messages/{messageId} {
        // Only participants can read messages
        allow read: if isAuthenticated() &&
          authUid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        // SECURITY: All message writes are Cloud Functions only
        allow create, update, delete: if false;
      }
    }

    // ============================================================
    // /docs/{docId}
    // Global Docs/Handbook Module
    // ============================================================
    match /docs/{docId} {
      // Helper to get user role from /users/{uid}
      function getUserRole() {
        return get(/databases/$(database)/documents/users/$(authUid())).data.role;
      }

      function hasGlobalRole(allowedRoles) {
        return isAuthenticated() && getUserRole() in allowedRoles;
      }

      // Read: RA, Staff, Admin, Leadership (Global Roles)
      // Note: "resident" is EXCLUDED from read access per requirements
      allow read: if hasGlobalRole(["ra", "staff", "admin", "leadership"]);

      // Write: Staff, Admin, Leadership only
      allow create, update, delete: if hasGlobalRole(["staff", "admin", "leadership"]);

      match /entries/{entryId} {
        // Read: RA, Staff, Admin, Leadership
        allow read: if hasGlobalRole(["ra", "staff", "admin", "leadership"]);

        // Write: Staff, Admin, Leadership only
        allow create, update, delete: if hasGlobalRole(["staff", "admin", "leadership"]);
      }
    }

    // ============================================================
    // DENY ALL OTHER PATHS
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
